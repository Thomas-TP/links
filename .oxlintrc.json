{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "react/no-array-index-key": "warn",
    "react/no-danger": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "node_modules", ".astro"]
}
