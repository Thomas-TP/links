---
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/outfit/800.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import Home from '../components/Home';
import '../styles/global.css';

const title = "Thomas Prud'homme — Links & Portfolio";
const description =
  "Apprenti CFC Informaticien en Exploitation & Infrastructure, basé dans l'Arc lémanique. Découvre mes projets, compétences et moyens de contact.";
const ogTitle = "Thomas Prud'homme — Apprenti CFC Informaticien";
const canonicalUrl = 'https://links.thomastp.ch';
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="informaticien, CFC, apprenti, infrastructure, Suisse, Thomas Prud'homme"
    />

    <!-- OpenGraph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${canonicalUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={ogTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonicalUrl}/og-image.png`} />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons: light/dark variants switched via prefers-color-scheme -->
    <link
      rel="icon"
      href="/favicon-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link rel="icon" href="/favicon.svg" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      try {
        var theme = localStorage.getItem('theme-preference');
        if (
          theme === 'dark' ||
          (!theme &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.add('light');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="antialiased">
    <Home client:load />
  </body>
</html>
